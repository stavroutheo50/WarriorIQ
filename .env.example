# Public identity. Paid checkout stays blocked until every required value is real.
WARRIORIQ_PUBLIC_BASE_URL=https://warrioriq.eu
# Optional persistent runtime directory. On Render, point this at the mounted
# persistent disk path. Leave empty locally to keep the existing project paths.
WARRIORIQ_DATA_DIR=
WARRIORIQ_OPERATOR_NAME=
WARRIORIQ_OPERATOR_ADDRESS=
WARRIORIQ_OPERATOR_REGISTRATION=
WARRIORIQ_OPERATOR_VAT=
WARRIORIQ_GOVERNING_COUNTRY=
WARRIORIQ_SUPPORT_EMAIL=
WARRIORIQ_PRIVACY_EMAIL=
WARRIORIQ_DMCA_EMAIL=
WARRIORIQ_DMCA_AGENT_NAME=
WARRIORIQ_POLICY_VERSION=2026-08-24
WARRIORIQ_MINIMUM_AGE=18
WARRIORIQ_VIDEO_RETENTION_DAYS=30
WARRIORIQ_FAILED_UPLOAD_RETENTION_HOURS=24
WARRIORIQ_ADMIN_EMAILS=
WARRIORIQ_EMAIL_PROVIDER=
WARRIORIQ_SMTP_HOST=
WARRIORIQ_SMTP_PORT=587
WARRIORIQ_SMTP_USERNAME=
WARRIORIQ_SMTP_PASSWORD=
WARRIORIQ_EMAIL_FROM=
WARRIORIQ_REQUIRE_EMAIL_VERIFICATION=false

# Optional social sign-in. Buttons are hidden until the state secret and that
# provider's client ID/secret are all configured. Register the exact HTTPS
# callback URLs documented in README.md; never place real values in this file.
WARRIORIQ_OAUTH_STATE_SECRET=
WARRIORIQ_GOOGLE_CLIENT_ID=
WARRIORIQ_GOOGLE_CLIENT_SECRET=
WARRIORIQ_APPLE_CLIENT_ID=
WARRIORIQ_APPLE_CLIENT_SECRET=
WARRIORIQ_FACEBOOK_CLIENT_ID=
WARRIORIQ_FACEBOOK_CLIENT_SECRET=
WARRIORIQ_MICROSOFT_CLIENT_ID=
WARRIORIQ_MICROSOFT_CLIENT_SECRET=

# Local/PyCharm runs analysis in the web process. "external" is retained for
# a GPU process that shares the web server's data directory. Production GPU
# machines should use "remote" on the web server, then set the public HTTPS
# URL and the same high-entropy token on the GPU machine before `python worker.py`.
WARRIORIQ_WORKER_MODE=inprocess
WARRIORIQ_WORKER_REMOTE_URL=
WARRIORIQ_WORKER_TOKEN=
# With "external" or "remote", a fight can be accepted while the analysis
# machine is switched off and claimed when it next connects. Set this to false
# to refuse uploads whenever no worker is currently online.
WARRIORIQ_ACCEPT_DEFERRED_ANALYSIS=true
WARRIORIQ_WORKER_ARTIFACT_MAX_BYTES=268435456
WARRIORIQ_WORKER_POLL_SECONDS=1.0
WARRIORIQ_WORKER_LEASE_SECONDS=180
WARRIORIQ_WORKER_STALE_SECONDS=300
WARRIORIQ_MIN_FREE_STORAGE_GB=2
WARRIORIQ_MAX_FIGHT_BYTES=2147483648
WARRIORIQ_MAX_VIDEO_SECONDS=10800
WARRIORIQ_MAX_VIDEO_PIXELS=8294400
WARRIORIQ_MALWARE_SCAN_COMMAND=
WARRIORIQ_MALWARE_SCAN_REQUIRED=false

# Optional advisory person detection on the manual fighter-selection page.
# It defaults off on Render so opening the page never loads YOLO by itself.
WARRIORIQ_SELECTION_DETECTION=false
WARRIORIQ_SAM_RECOVERY=false
WARRIORIQ_SAM_CONTINUOUS=false

# Billing remains off unless explicitly enabled and Stripe is configured.
WARRIORIQ_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ATHLETE=
STRIPE_PRICE_ATHLETE_PRO=
STRIPE_PRICE_COACH=
STRIPE_PRICE_GYM=

# Optional external AI recovery remains off per upload unless the user checks it.
OPENAI_API_KEY=
WARRIORIQ_OPENAI_MODEL=gpt-5.6-terra
