# Python and local tooling
__pycache__/
*.py[cod]
.venv/
.idea/
.tmp/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local model/runtime caches
.huggingface/
.ultralytics/
Ultralytics/
# `models/*` rather than `models/`: git cannot re-include a file whose parent
# directory is excluded, so with the directory form the `!models/...` lines
# further down were silently dead. referee_probe.npz only survived because it
# was committed before the rule existed.
models/*
*.pt
*.engine
*.onnx

# Private and generated application data
.env
.env.local
.env.production
.env.*.local
warrioriq.sqlite3
# Measured once per machine and read back by every later analysis, so the
# same video always plans the same sampling stride. Local hardware fact,
# not source: committing one machine's timings would plan everybody
# else's runs from it. See core/machine_profile.py.
machine_profile.json
uploads/
outputs/
dataset/regression/private/

# Local logs and operating-system files
*.log
.codex-*.log
Thumbs.db
.DS_Store
DEPLOYED_COMMIT
logs/

# Labelled training sequences. These are pose measurements of real, identifiable
# athletes - youth competitors in the footage this was built on - which makes
# them personal data under GDPR, and this repository is public. They live on the
# server and are fetched with tools/pull_dataset.py; they must never be a commit.
dataset/sequences/

# BoxingVI, and what tools/import_boxingvi.py builds from it. Same reasoning as
# above and then some: these are pose measurements of identifiable athletes cut
# from YouTube sparring footage, the source repository states no licence, and
# this repository is public. Re-fetch it with the importer rather than carrying
# it here - it is a download, not a thing this project owns.
dataset/boxingvi/
dataset/sequences_boxingvi/
dataset/sequences_own_negatives/
dataset/sequences_combined/
# TKD-Kick3 (Zenodo 10.5281/zenodo.20390892, CC BY 4.0). The licence would
# allow redistribution with attribution, unlike BoxingVI - but it is still a
# 58 MB download that this project does not own, and tools/import_tkd_kick3.py
# re-fetches it. Pose sequences of identifiable athletes stay out of a public
# repository on the same reasoning as everything above.
dataset/tkd_kick3/
dataset/sequences_tkd_kick3/

# Fight footage stays on the machine that filmed it.
#
# fights/ is a local drop-box - its own placeholder says "these never leave
# your PC" - but three real bouts were committed into it, 45MB of identifiable
# athletes in a public repository. The folder and its instructions stay; the
# video does not.
fights/*
!fights/PUT_FIGHT_VIDEOS_HERE.txt

# The referee probe is a 1 KB trained artefact, not a downloaded weights file:
# without it in the repo the filter cannot be enabled on any other machine.
!models/referee_probe.npz

# Same reasoning: the tracker config is measured settings, not weights. It had
# been sitting untracked on one machine, which meant the thresholds every
# identity decision depends on existed in exactly one place, could not be
# reviewed in a diff, and were missing from any fresh checkout - including for
# tests/test_core.py, which asserts on its contents.
!models/warrioriq_botsort.yaml

# Generated labelling packs: clips plus a self-contained page, megabytes each.
labelpack/

# The single-worker heartbeat. Machine-local state, never shared.
worker.lock

# Generated signing key when WARRIORIQ_OAUTH_STATE_SECRET is unset. Never commit.
session-secret.txt
data/

# Rotated application logs. They can carry request detail and user email.
*.log
*.log.[0-9]
logs/
